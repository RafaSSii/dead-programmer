<article class="post-page"><nav class="breadcrumbs"><%= link_to "Artigos", root_path %><span>/</span><span>Leitura</span></nav><header class="post-header"><div class="eyebrow"><span class="eyebrow-line"></span> NOTAS DE ESTUDO</div><h1><%= @article.title %></h1><% if @article.excerpt.present? %><p class="post-excerpt"><%= @article.excerpt %></p><% end %><div class="post-meta"><span>Publicado em <%= (@article.published_at || @article.created_at).strftime("%d/%m/%Y") %></span><span>·</span><span><%= @article.reading_minutes %> min de leitura</span></div></header><div class="post-divider"></div><div class="prose"><%= article_body_html(@article) %></div><div class="post-end"><span>✳</span><p>Obrigado por ler. Continue curioso.</p></div><%= link_to "← Voltar para os artigos", root_path, class: "back-link" %></article>
