<%= form_with model: [:admin, article], class: "article-form", data: { controller: "editor" } do |f| %>
<% if article.errors.any? %><div class="form-errors"><strong>Não foi possível salvar:</strong><ul><% article.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul></div><% end %>
<div class="form-field"><%= f.label :title, "Título" %><%= f.text_field :title, required: true, maxlength: 180, placeholder: "O que você descobriu?", class: "form-input" %></div>
<div class="form-field"><%= f.label :slug, "URL personalizada (opcional)" %><%= f.text_field :slug, placeholder: "gerado-a-partir-do-titulo", class: "form-input" %><p class="field-hint">Se ficar em branco, será gerada a partir do título.</p></div>
<div class="form-field"><%= f.label :excerpt, "Resumo" %><%= f.text_area :excerpt, rows: 2, maxlength: 320, placeholder: "Uma frase para apresentar o artigo…", class: "form-input" %></div>
<div class="form-grid"><div class="form-field"><%= f.label :status, "Estado" %><%= f.select :status, [["Rascunho","draft"],["Publicado","published"]], {}, class: "form-input" %></div><div class="form-field"><%= f.label :content_format, "Modo de escrita" %><%= f.select :content_format, [["Markdown","markdown"],["Editor visual","visual"]], {}, class: "form-input", data: { editor_target: "format", action: "change->editor#switchFormat" } %></div></div>
<div class="form-field"><%= f.label :body, "Conteúdo" %><%= f.text_area :body, rows: 18, required: true, class: "form-input editor-textarea", data: { editor_target: "markdown" }, placeholder: "# Sua anotação\n\nEscreva em Markdown..." %>
<div class="visual-editor-wrap" data-editor-target="visualWrap" hidden><div class="visual-toolbar"><button type="button" data-action="editor#bold"><strong>B</strong></button><button type="button" data-action="editor#italic"><em>I</em></button><button type="button" data-action="editor#heading">H2</button><button type="button" data-action="editor#list">• Lista</button><button type="button" data-action="editor#quote">“ ”</button></div><div class="visual-editor" contenteditable="true" role="textbox" aria-multiline="true" data-editor-target="visual" data-action="input->editor#syncVisual"></div></div><p class="field-hint">Markdown aceita títulos com #, listas com -, código entre crases e links [texto](https://...).</p></div>
<div class="form-actions"><%= f.submit(article.persisted? ? "Salvar alterações" : "Salvar artigo", class: "button button-primary") %><%= link_to "Cancelar", admin_articles_path, class: "text-link" %></div><% end %>
