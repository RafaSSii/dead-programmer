<!DOCTYPE html>
<html lang="pt-BR" data-controller="theme">
<head>
  <title><%= content_for(:title) || "Dead Programmer — caderno digital" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= content_for(:meta_description) || 'Artigos e anotações sobre programação, Linux e tecnologia.' %>">
  <meta name="color-scheme" content="light dark">
  <%= csrf_meta_tags %><%= csp_meta_tag %><%= yield :head %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %><%= javascript_importmap_tags %>
</head>
<body class="site-shell">
<header class="site-header"><div class="site-header-inner">
  <%= link_to root_path, class: "brand" do %><span class="brand-mark">dp.</span><span>dead programmer<span class="brand-dot">/</span></span><% end %>
  <nav class="main-nav" aria-label="Navegação principal">
    <%= link_to "Artigos", root_path, class: "nav-link" %><a href="/#sobre" class="nav-link">Sobre</a>
    <%= link_to "Escrever", new_admin_article_path, class: "nav-link nav-write" %>
    <button type="button" class="theme-toggle" data-action="theme#toggle" aria-label="Alternar tema"><span data-theme-target="icon">☾</span><span class="theme-toggle-label">Tema</span></button>
  </nav>
</div></header>
<main class="page-content">
  <% if flash[:notice].present? %><div class="flash flash-notice"><%= flash[:notice] %></div><% end %>
  <% if flash[:alert].present? %><div class="flash flash-alert"><%= flash[:alert] %></div><% end %>
  <%= yield %>
</main>
<footer class="site-footer"><div class="footer-inner"><span>Feito com curiosidade, café e Ruby on Rails.</span><span>© <%= Date.current.year %> dead programmer</span></div></footer>
</body></html>
